{
  "name": "megadoor-os-front-end",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regras": "vitest run testes/regras",
    "test:firestore": "npx --yes firebase-tools@15.26.0 emulators:exec --project demo-megadoor --only firestore \"vitest run --config vitest.regras-firestore.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:real": "bash scripts/testar-e2e-real.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:packaging": "node packaging/scripts/testar-manifesto.mjs && node packaging/scripts/testar-avisos-de-terceiros.mjs && node --test packaging/windows/runtime/static-server.test.mjs",
    "test:packaging:linux": "bash packaging/linux/test-linux-packaging.sh",
    "build:windows": "bash packaging/windows/build-release.sh",
    "build:linux": "bash packaging/linux/build-release.sh"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "hash-wasm": "4.12.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.5"
  }
}
